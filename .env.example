# Public (baked into the build)
NEXT_PUBLIC_GA_ID=            # e.g. G-XXXXXXX — leave empty to disable analytics

# Cloudflare Pages → Settings → Environment variables (server-side, used by functions/api/book.ts)
BOOKING_WEBHOOK_URL=          # GoHighLevel / Make.com / Google Apps Script webhook
RESEND_API_KEY=               # optional: email each booking
BOOKING_EMAIL_TO=             # clinic inbox
BOOKING_EMAIL_FROM=           # verified sender, e.g. Jerush Website <bookings@jerushdental.in>
